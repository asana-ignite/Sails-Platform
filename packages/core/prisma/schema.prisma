generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core"]
}

model Tenant {
  id              String            @id @default(cuid())
  name            String
  schemaName      String            @unique @map("schema_name")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")
  dataAuditLogs   DataAuditLog[]
  systemEventLogs SystemEventLog[]
  ddlLogs         DdlLog[]
  consoleApps     ConsoleApp[]
  consoleWidgets  ConsoleWidget[]
  tables          TableDefinition[]
  teams           Team[]
  users           User[]
  positions       Position[]
  companyProfile  CompanyProfile?

  @@index([createdAt])
  @@map("tenants")
  @@schema("core")
}

model TableDefinition {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  name        String
  tableName   String            @map("table_name")
  description String?
  isSystem    Boolean           @default(false) @map("is_system")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")
  fields      FieldDefinition[]
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules       ValidationRule[]
  layouts     TableLayout[]
  menus       ConsoleMenu[]

  @@unique([tenantId, tableName])
  @@index([tenantId])
  @@map("tables")
  @@schema("core")
}

model TableLayout {
  id               String           @id @default(cuid())
  tableId          String?          @map("table_id")
  layoutType       String           @default("data") @map("layout_type")
  viewType         String           @map("view_type")
  name             String
  systemName       String           @map("system_name")
  description      String?
  isDefault        Boolean          @default(false) @map("is_default")
  config           Json
  publishedConfig  Json?            @map("published_config")
  status           String           @default("draft") @map("status")
  recordTitleField String?          @map("record_title_field")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")
  table            TableDefinition? @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, viewType, name])
  @@unique([systemName])
  @@index([tableId])
  @@map("table_layouts")
  @@schema("core")
}

model FieldDefinition {
  id           String           @id @default(cuid())
  tableId      String           @map("table_id")
  name         String
  fieldName    String           @map("field_name")
  physicalType String           @map("physical_type")
  logicalType  String           @map("logical_type")
  config       Json?
  isRequired   Boolean          @default(false) @map("is_required")
  isSystem     Boolean          @default(false) @map("is_system")
  defaultValue String?          @map("default_value")
  description  String?          @map("description")
  createdAt    DateTime         @default(now()) @map("created_at")
  table        TableDefinition  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  rules        ValidationRule[]

  @@unique([tableId, fieldName])
  @@index([tableId])
  @@map("fields")
  @@schema("core")
}

model ValidationRule {
  id             String           @id @default(cuid())
  tableId        String           @map("table_id")
  fieldId        String?          @map("field_id")
  ruleType       String
  ruleDefinition String
  errorMessage   String?          @map("error_message")
  field          FieldDefinition? @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  table          TableDefinition  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@index([fieldId])
  @@map("validation_rules")
  @@schema("core")
}

model ConsoleApp {
  id                 String        @id @default(cuid())
  tenantId           String        @map("tenant_id")
  name               String
  slug               String?
  description        String?
  icon               String?
  order              Int           @default(0)
  isSystem           Boolean       @default(false) @map("is_system")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at")
  requiredCapability String?       @map("required_capability")
  widgetBarEnabled   Boolean       @default(false) @map("widget_bar_enabled")
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menus              ConsoleMenu[]
  widgets            ConsoleWidget[]

  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("console_apps")
  @@schema("core")
}

model ConsoleMenu {
  id                 String          @id @default(cuid())
  tenantId           String          @map("tenant_id")
  appId              String?         @map("app_id")
  label              String
  icon               String?
  path               String?
  actionType         String          @default("data_model") @map("action_type")
  parentId           String?         @map("parent_id")
  order              Int             @default(0)
  isSystem           Boolean         @default(false) @map("is_system")
  requiredCapability String?         @map("required_capability")
  componentKey       String?          @map("component_key")
  dataModelId        String?          @map("data_model_id")
  listViewId         String?          @map("list_view")
  app                ConsoleApp?      @relation(fields: [appId], references: [id], onDelete: Cascade)
  parent             ConsoleMenu?     @relation("MenuHierarchy", fields: [parentId], references: [id])
  children           ConsoleMenu[]    @relation("MenuHierarchy")
  dataModel          TableDefinition? @relation(fields: [dataModelId], references: [id], onDelete: SetNull)

  @@index([appId])
  @@index([parentId])
  @@index([tenantId])
  @@map("console_menus")
  @@schema("core")
}

model ConsoleWidget {
  id                 String     @id @default(cuid())
  tenantId           String     @map("tenant_id")
  appId              String?    @map("app_id")
  label              String
  icon               String?
  componentKey       String?    @map("component_key")
  openIn             String     @default("bar") @map("open_in")
  config             Json?      @map("config")
  order              Int        @default(0)
  enabled            Boolean    @default(true)
  isSystem           Boolean    @default(false) @map("is_system")
  requiredCapability String?    @map("required_capability")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  app    ConsoleApp? @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appId])
  @@map("console_widgets")
  @@schema("core")
}

model Team {
  id                String             @id @default(cuid())
  tenantId          String             @map("tenant_id")
  name              String
  isSystemAdmin     Boolean            @default(false) @map("is_system_admin")
  parentId          String?            @map("parent_id")
  objectPermissions ObjectPermission[]
  systemPermissions SystemPermission[]
  parent            Team?              @relation("TeamHierarchy", fields: [parentId], references: [id])
  children          Team[]             @relation("TeamHierarchy")
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members           UserTeam[]
  positions         TeamPosition[]

  @@index([tenantId])
  @@index([parentId])
  @@map("teams")
  @@schema("core")
}

enum AccessScope {
  NONE
  OWNER
  TEAM
  HIERARCHY
  ALL

  @@schema("core")
}

model ObjectPermission {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  objectName       String       @map("object_name")
  
  teamId           String?      @map("team_id")
  positionId       String?      @map("position_id")
  userId           String?      @map("user_id")
  
  canCreate        Boolean      @default(false) @map("can_create")
  canDelete        Boolean      @default(false) @map("can_delete")
  
  readScope        AccessScope  @default(OWNER) @map("read_scope")
  modifyScope      AccessScope  @default(OWNER) @map("modify_scope")

  team             Team?        @relation(fields: [teamId], references: [id])
  position         Position?    @relation(fields: [positionId], references: [id])
  user             User?        @relation(fields: [userId], references: [id])

  @@unique([teamId, objectName])
  @@unique([positionId, objectName])
  @@unique([userId, objectName])
  @@index([teamId])
  @@index([positionId])
  @@index([userId])
  @@map("object_permissions")
  @@schema("core")
}

model SystemPermission {
  id         String @id @default(cuid())
  teamId     String @map("team_id")
  capability String
  team       Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, capability])
  @@index([teamId])
  @@map("system_permissions")
  @@schema("core")
}

/// Core identity record. Extended beyond the NextAuth default to carry
/// SAILS multi-tenant context (tenantId, role, teamId) which are
/// embedded in the JWT by `src/lib/auth/session.ts`.
model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?        @map("email_verified")
  image           String?
  /// Hashed password — used only for the SAILS internal credential provider.
  /// NULL when the user authenticates exclusively via OAuth (Google, Azure).
  password        String?
  /// FK → core.tenants.  NULL only for SUPER_ADMIN accounts that are not
  /// scoped to a single tenant.
  tenantId        String?          @map("tenant_id")
  /// Top-level role fast-path used by AccessGuard:
  /// SUPER_ADMIN | TENANT_ADMIN | MEMBER
  /// Fine-grained RBAC is delegated to ObjectPermission via teamId.
  role            String           @default("MEMBER")
  isActive        Boolean          @default(true) @map("is_active")
  phone           String?
  title           String?
  metadata        Json             @default("{}")
  googleId        String?          @unique @map("google_id")
  googleDomain    String?          @map("google_domain")
  lastLoginAt     DateTime?        @map("last_login_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  accounts        Account[]
  dataAuditLogs   DataAuditLog[]
  systemEventLogs SystemEventLog[]
  ddlLogs         DdlLog[]
  sessions        Session[]
  teams           UserTeam[]
  positionSlots   PositionSlot[]
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objectPermissions ObjectPermission[]

  @@index([tenantId])
  @@map("users")
  @@schema("core")
}

model UserTeam {
  userId   String  @map("user_id")
  teamId   String  @map("team_id")
  isLeader Boolean @default(false) @map("is_leader")
  team     Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId])
  @@map("user_teams")
  @@schema("core")
}

/// OAuth / OIDC linked provider accounts (Google, Microsoft Entra ID, etc.).
/// Follows the NextAuth PrismaAdapter contract exactly.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
  @@schema("core")
}

/// Database-backed sessions used when NextAuth `strategy = "database"`.
/// When `strategy = "jwt"` (current default) this table is unused but kept
/// for future Enterprise Federation (IAM Phase B).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("core")
}

/// One-time tokens for email verification and magic-link sign-in.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
  @@schema("core")
}

model DataAuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  ipAddress  String?  @map("ip_address")
  action     String
  objectName String   @map("object_name")
  recordId   String?  @map("record_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, objectName, recordId])
  @@index([userId])
  @@index([createdAt])
  @@map("data_audit_logs")
  @@schema("core")
}

model SystemEventLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  ipAddress  String?  @map("ip_address")
  category   String   // e.g. "METADATA", "USER_MANAGEMENT", "SETTINGS"
  action     String   // e.g. "CREATE", "UPDATE", "DELETE"
  eventName  String   @map("event_name")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, category])
  @@index([userId])
  @@index([createdAt])
  @@map("system_event_logs")
  @@schema("core")
}

model DdlLog {
  id          String   @id @default(cuid())
  tenantId    String?  @map("tenant_id")
  userId      String?  @map("user_id")
  schemaName  String   @map("schema_name")
  tableName   String?  @map("table_name")
  action      String
  sqlExecuted String   @map("sql_executed")
  createdAt   DateTime @default(now()) @map("created_at")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([schemaName])
  @@index([createdAt])
  @@map("ddl_logs")
  @@schema("core")
}

model Position {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  name        String
  prefix      String
  description String?
  headCount   Int            @default(1) @map("head_count")
  slots       PositionSlot[]
  teamLinks   TeamPosition[]
  objectPermissions ObjectPermission[]
  
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@unique([tenantId, prefix])
  @@map("positions")
  @@schema("core")
}

model PositionSlot {
  id         String   @id // e.g., "DEV-01", "DEV-02"
  positionId String   @map("position_id")
  userId     String?  @map("user_id") // Optional until assigned
  
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([positionId])
  @@index([userId])
  @@map("position_slots")
  @@schema("core")
}

model TeamPosition {
  teamId     String   @map("team_id")
  positionId String   @map("position_id")
  
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([teamId, positionId])
  @@index([positionId])
  @@map("team_positions")
  @@schema("core")
}

model CompanyProfile {
  id              String   @id @default(cuid())
  tenantId        String   @unique @map("tenant_id")
  
  // Organization Details
  legalName       String?  @map("legal_name")
  tradingName     String?  @map("trading_name")
  taxId           String?  @map("tax_id")
  industry        String?
  companySize     String?  @map("company_size")
  websiteUrl      String?  @map("website_url")

  // Contact & Headquarters
  businessContactName  String?  @map("business_contact_name")
  corporateEmail       String?  @map("corporate_email")
  businessContactPhone String?  @map("business_contact_phone")

  supportContactName   String?  @map("support_contact_name")
  supportEmail         String?  @map("support_email")
  supportPhone         String?  @map("support_phone")
  phone                String?  // Legacy primary phone
  fax                  String?  // Legacy fax

  streetAddress        String?  @map("street_address")
  subDistrict          String?  @map("sub_district")
  city                 String?
  postalCode           String?  @map("postal_code")
  country              String?

  // Legal & Compliance
  dpoName         String?  @map("dpo_name")
  dpoEmail        String?  @map("dpo_email")
  termsUrl        String?  @map("terms_url")
  privacyUrl      String?  @map("privacy_url")

  // Localization & Financial Settings
  baseCurrency             String?  @default("THB") @map("base_currency")
  fiscalYearStartMonth     String?  @default("January") @map("fiscal_year_start_month")
  timezone                 String?  @default("Asia/Bangkok") @map("timezone")
  dateFormat               String?  @default("YYYY-MM-DD") @map("date_format")
  timeFormat               String?  @default("24h") @map("time_format")

  // System Security & Governance Settings
  loginTagline             String?  @map("login_tagline")
  allowSelfRegistration    Boolean  @default(false) @map("allow_self_registration")
  allowedEmailDomains      String?  @map("allowed_email_domains")
  defaultUserRole          String?  @default("MEMBER") @map("default_user_role")
  defaultLandingPage       String?  @default("/console/dashboard") @map("default_landing_page")
  inactivityTimeoutMinutes Int?     @default(30) @map("inactivity_timeout_minutes")
  maxFileUploadMb          Int?     @default(25) @map("max_file_upload_mb")

  // Maintenance & Alerts Settings
  maintenanceMode       Boolean  @default(false) @map("maintenance_mode")
  announcementBannerText String? @map("announcement_banner_text")
  announcementType      String?  @default("info") @map("announcement_type")

  // Branding & Theme
  themeConfig     Json?    @map("theme_config")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("company_profiles")
  @@schema("core")
}
