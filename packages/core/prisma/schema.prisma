generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core"]
}

model Tenant {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  schemaName  String            @unique @map("schema_name")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")
  auditLogs   AuditLog[]
  consoleApps ConsoleApp[]
  tables      TableDefinition[]
  teams       Team[]
  users       User[]

  @@map("tenants")
  @@schema("core")
}

model TableDefinition {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  name        String
  tableName   String            @map("table_name")
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  fields      FieldDefinition[]
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules       ValidationRule[]

  @@unique([tenantId, tableName])
  @@map("tables")
  @@schema("core")
}

model FieldDefinition {
  id           String           @id @default(uuid()) @db.Uuid
  tableId      String           @map("table_id") @db.Uuid
  name         String
  fieldName    String           @map("field_name")
  physicalType String           @map("physical_type")
  logicalType  String           @map("logical_type")
  config       Json?
  isRequired   Boolean          @default(false) @map("is_required")
  defaultValue String?          @map("default_value")
  createdAt    DateTime         @default(now()) @map("created_at")
  table        TableDefinition  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  rules        ValidationRule[]

  @@unique([tableId, fieldName])
  @@map("fields")
  @@schema("core")
}

model ValidationRule {
  id             String           @id @default(uuid()) @db.Uuid
  tableId        String           @map("table_id") @db.Uuid
  fieldId        String?          @map("field_id") @db.Uuid
  ruleType       String
  ruleDefinition String
  errorMessage   String?          @map("error_message")
  field          FieldDefinition? @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  table          TableDefinition  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("validation_rules")
  @@schema("core")
}

model ConsoleApp {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  name               String
  icon               String?
  order              Int           @default(0)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at")
  requiredCapability String?       @map("required_capability")
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menus              ConsoleMenu[]

  @@unique([tenantId, name])
  @@map("console_apps")
  @@schema("core")
}

model ConsoleMenu {
  id                 String        @id @default(uuid()) @db.Uuid
  appId              String?       @map("app_id") @db.Uuid
  label              String
  icon               String?
  path               String?
  actionType         String        @default("table") @map("action_type")
  parentId           String?       @map("parent_id") @db.Uuid
  order              Int           @default(0)
  requiredCapability String?       @map("required_capability")
  componentKey       String?       @map("component_key")
  app                ConsoleApp?   @relation(fields: [appId], references: [id], onDelete: Cascade)
  parent             ConsoleMenu?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children           ConsoleMenu[] @relation("MenuHierarchy")

  @@map("console_menus")
  @@schema("core")
}

model Team {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  name              String
  isSystemAdmin     Boolean            @default(false) @map("is_system_admin")
  parentId          String?            @map("parent_id") @db.Uuid
  objectPermissions ObjectPermission[]
  systemPermissions SystemPermission[]
  parent            Team?              @relation("TeamHierarchy", fields: [parentId], references: [id])
  children          Team[]             @relation("TeamHierarchy")
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members           UserTeam[]

  @@map("teams")
  @@schema("core")
}

model ObjectPermission {
  id            String  @id @default(uuid()) @db.Uuid
  teamId        String  @map("team_id") @db.Uuid
  objectName    String  @map("object_name")
  canCreate     Boolean @default(false) @map("can_create")
  canRead       Boolean @default(false) @map("can_read")
  canUpdate     Boolean @default(false) @map("can_update")
  canDelete     Boolean @default(false) @map("can_delete")
  viewAllData   Boolean @default(false) @map("view_all_data")
  modifyAllData Boolean @default(false) @map("modify_all_data")
  team          Team    @relation(fields: [teamId], references: [id])

  @@unique([teamId, objectName])
  @@map("object_permissions")
  @@schema("core")
}

model SystemPermission {
  id         String @id @default(uuid()) @db.Uuid
  teamId     String @map("team_id") @db.Uuid
  capability String
  team       Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, capability])
  @@map("system_permissions")
  @@schema("core")
}

/// Core identity record. Extended beyond the NextAuth default to carry
/// INIDOS multi-tenant context (tenantId, role, teamId) which are
/// embedded in the JWT by `src/lib/auth/session.ts`.
model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String?
  email         String     @unique
  emailVerified DateTime?  @map("email_verified")
  image         String?
  /// Hashed password — used only for the INIDOS internal credential provider.
  /// NULL when the user authenticates exclusively via OAuth (Google, Azure).
  password      String?
  /// FK → core.tenants.  NULL only for SUPER_ADMIN accounts that are not
  /// scoped to a single tenant.
  tenantId      String?    @map("tenant_id") @db.Uuid
  /// Top-level role fast-path used by AccessGuard:
  /// SUPER_ADMIN | TENANT_ADMIN | MEMBER
  /// Fine-grained RBAC is delegated to ObjectPermission via teamId.
  role          String     @default("MEMBER")
  isActive      Boolean    @default(true) @map("is_active")
  phone         String?
  metadata      Json       @default("{}")
  googleId      String?    @unique @map("google_id")
  googleDomain  String?    @map("google_domain")
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")
  accounts      Account[]
  auditLogs     AuditLog[]
  sessions      Session[]
  teams         UserTeam[]
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("users")
  @@schema("core")
}

model UserTeam {
  userId   String  @map("user_id") @db.Uuid
  teamId   String  @map("team_id") @db.Uuid
  isLeader Boolean @default(false) @map("is_leader")
  team     Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@map("user_teams")
  @@schema("core")
}

/// OAuth / OIDC linked provider accounts (Google, Microsoft Entra ID, etc.).
/// Follows the NextAuth PrismaAdapter contract exactly.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
  @@schema("core")
}

/// Database-backed sessions used when NextAuth `strategy = "database"`.
/// When `strategy = "jwt"` (current default) this table is unused but kept
/// for future Enterprise Federation (IAM Phase B).
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("core")
}

/// One-time tokens for email verification and magic-link sign-in.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
  @@schema("core")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  ipAddress  String?  @map("ip_address")
  action     String
  objectName String   @map("object_name")
  recordId   String?  @map("record_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, objectName, recordId])
  @@map("audit_logs")
  @@schema("core")
}
